# Copy this file to `.env` for local development (`npm run dev:api`).
# `.env` is gitignored — never commit real passwords.
# In Dokploy these are set in the application's Environment tab, NOT here.

# Postgres connection string (required).
# Local:   the docker run command in README.md gives you this URL.
# Dokploy: the database service's "Internal Connection URL",
#          e.g. postgresql://weddingwallet:PASSWORD@weddingwallet-db-abc123:5432/weddingwallet
DATABASE_URL=postgresql://weddingwallet:weddingwallet@localhost:5432/weddingwallet

# Port the Node server listens on (Dokploy domain "Container Port" must match).
PORT=3000

# Load db/seed.sql on start-up, but ONLY if all tables are empty.
SEED_DATA=false

# Optional: verify Cloudflare Access login on every API call (see server/access.ts).
# Leave blank unless the site is behind Cloudflare Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
