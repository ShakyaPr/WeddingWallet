{
  "name": "weddingwallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wedding expense tracker — React + Vite SPA served by a Node (Hono) API on Postgres. Deploys to Dokploy via Dockerfile.",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.6.3",
    "jose": "^6.2.18",
    "openid-client": "^6.9.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=22"
  }
}
